{
  "manifest_version": 3,
  "name": "QA Autofill Assistant",
  "version": "1.0.0",
  "description": "Click a field and autofill it with test data.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["faker-bundle.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["highlight.css"]
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "storage": {
    "sync": {}
  }
}